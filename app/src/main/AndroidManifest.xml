<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.rotation_vector"
        android:required="false" />

    <application
        android:name=".GyreApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Gyre">
        <!--
            The app lays itself out from one window and owns a live EGL context, so it handles
            configuration changes rather than being recreated for them: a recreation disposes
            GyrePreviewView, which rebuilds a thread, an EGL context and every decoded 2600x2600
            layer. Compose still sees the new Configuration, so isSystemInDarkTheme() — and with it
            the automatic dark variants — keeps following the system.

            Every surface is rendered in the shape the host supplies. fullUser follows the user's
            rotation-lock preference while admitting portrait, landscape and both reverse
            orientations when rotation is enabled; there is no portrait coordinate transform or
            counter-rotation in the renderer.

            The wallpaper service remains separate from this request: its surface belongs to the
            launcher and a normal wallpaper engine cannot choose its dimensions. A portrait-only
            launcher therefore keeps receiving a portrait wallpaper even while this activity can
            show the native landscape result for a hypothetical landscape host.

            DiscouragedApi is suppressed only here. fullUser expresses the user's own orientation
            policy on compact displays rather than pinning one shape, and the adaptive layout still
            handles every surface on larger displays where the platform ignores the request.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden"
            android:exported="true"
            android:screenOrientation="fullUser"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".wallpaper.GyreWallpaperService"
            android:description="@string/wallpaper_description"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:ignore="MissingClass"
            tools:node="remove" />

    </application>

</manifest>
